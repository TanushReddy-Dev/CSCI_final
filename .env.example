# Environment Variables
# Copy this file to .env and fill in values

# Path to model_artifacts/ directory
MODEL_DIR=./model_artifacts

# Path to evaluation_outputs/ directory
EVAL_DIR=./evaluation_outputs

# Set to "true" to run frontend in demo mode without live model
DEMO_MODE=false

# Inference API port
API_PORT=8000

# Frontend dev server port
FRONTEND_PORT=5173

# API URL for frontend to connect to
VITE_API_URL=http://localhost:8000
